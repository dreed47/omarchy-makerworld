#!/usr/bin/env python3
"""Sign in to Bambu Cloud and store a token for the MakerWorld plugin.

Three ways to get a token, in order of least hassle:

  A. Import it from Bambu Studio / Orca Slicer (no password needed) - offered
     automatically if a signed-in slicer config is found, or `--from-slicer`.
  B. Log in with your Bambu account - prompts for password and, usually, a
     code emailed by Bambu (authenticator/TFA accounts also handled).
  C. Paste a token from browser dev tools:  makerworld-token --paste

Run this in a real terminal - options A/B prompt interactively.

Usage:
  makerworld-login                        # auto: offer slicer import, else login
  makerworld-login --from-slicer          # import from Bambu Studio / Orca only
  makerworld-login --from-slicer ~/path   # ...from a specific config dir/file
  makerworld-login --region china         # .cn account
  makerworld-login --account you@x.com --password-stdin < pwfile
  makerworld-login --account you@x.com --password-stdin --code 123456 < pwfile
"""

from __future__ import annotations

import argparse
import getpass
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _mwlib as mw  # noqa: E402


def _extract_tokens(obj: dict) -> dict | None:
    d = obj if isinstance(obj, dict) else {}
    inner = mw.unwrap(d) if isinstance(mw.unwrap(d), dict) else {}
    for src in (d, inner):
        at = src.get("accessToken") or src.get("access_token")
        if at:
            return {
                "accessToken": at,
                "refreshToken": src.get("refreshToken") or src.get("refresh_token") or "",
                "expiresIn": src.get("expiresIn") or src.get("expires_in"),
            }
    return None


def _needs_code(obj: dict) -> bool:
    d = obj if isinstance(obj, dict) else {}
    lt = str(d.get("loginType") or d.get("login_type") or "").lower()
    return lt in ("verifycode", "verify_code", "email", "emailcode")


def _tfa_key(obj: dict) -> str:
    d = obj if isinstance(obj, dict) else {}
    return d.get("tfaKey") or d.get("tfa_key") or ""


def _finish(record: dict, source: str) -> int:
    mw.save_token(record)
    if mw.scaffold_config():
        print(f"Wrote default config      {mw.CONFIG_FILE}")
    print(f"Saved token               {mw.TOKEN_FILE}")
    print(f"  source                  {source}")
    print(f"  account                 {record.get('account', '(unknown)')}")
    print(f"  region                  {record.get('region', 'global')}")
    print(f"  access token            {mw.mask(record['accessToken'])}")
    print(f"  expires                 {mw.exp_human(record['accessToken'])}")
    print(f"  refresh token           "
          f"{'yes' if record.get('refreshToken') else 'NO (re-run makerworld-login when it expires)'}")
    print("\nEnable the MakerWorld plugin in Omarchy (or restart omarchy-shell) to start polling.")
    return 0


def _verify(record: dict) -> bool:
    """Confirm a token authenticates; fill in the account name from the profile."""
    try:
        r = mw.http("GET", mw.api_base(record["region"])
                    + "/v1/design-user-service/my/profile", token=record["accessToken"])
    except SystemExit:
        return False
    if r.status != 200:
        return False
    d = mw.unwrap(r.json()) or {}
    name = d.get("account") or d.get("name") or d.get("handle")
    if name:
        record["account"] = str(name)
    return True


def _import_from_slicer(explicit: str | None) -> int:
    found = mw.find_slicer_token(explicit)
    if not found:
        print("No Bambu Studio / Orca Slicer config found. Looked in:", file=sys.stderr)
        for _, d in mw.SLICER_DIRS:
            print("  " + d, file=sys.stderr)
        print("\nSign in to one of those slicers, or run  makerworld-login  with your "
              "Bambu password.", file=sys.stderr)
        return 1
    if found.get("error"):
        print(found["error"] + ".", file=sys.stderr)
        for f in found.get("encrypted_files", []):
            print("  encrypted:  " + f, file=sys.stderr)
        for f in found.get("seen_files", []):
            print("  inspected:  " + f, file=sys.stderr)
        if found.get("seen_keys"):
            print("  keys seen:  " + ", ".join(found["seen_keys"]), file=sys.stderr)
        print("\nModern Bambu Studio / Orca encrypt the cloud token, so import often\n"
              "isn't possible. Use  makerworld-login  (Bambu password) or\n"
              "makerworld-token --paste  (token from browser dev tools).", file=sys.stderr)
        return 1

    record = {
        "accessToken": found["accessToken"],
        "refreshToken": found.get("refreshToken", ""),
        "region": found.get("region", "global"),
        "account": "(imported)",
    }
    print(f"Found a Bambu Cloud token in {found['source']}")
    print("Checking it works ...")
    if not _verify(record):
        print("\nThat token did not authenticate - it is probably stale.", file=sys.stderr)
        print("Open the slicer and sign in again, or run  makerworld-login  with your "
              "password.", file=sys.stderr)
        return 1
    return _finish(record, found["source"])


def main() -> int:
    ap = argparse.ArgumentParser(description="Sign in to Bambu Cloud for the MakerWorld plugin.")
    ap.add_argument("--region", choices=["global", "china"], help="account region (default: ask)")
    ap.add_argument("--account", help="email or phone (default: ask)")
    ap.add_argument("--password-stdin", action="store_true",
                    help="read the password from the first line of stdin instead of prompting")
    ap.add_argument("--code", help="emailed verification / TFA code, if you already have one")
    ap.add_argument("--from-slicer", nargs="?", const=True, default=False,
                    metavar="DIR_OR_FILE",
                    help="import the token from Bambu Studio / Orca Slicer instead of logging in")
    args = ap.parse_args()

    if args.from_slicer:
        explicit = args.from_slicer if isinstance(args.from_slicer, str) else None
        return _import_from_slicer(explicit)

    interactive = sys.stdin.isatty()

    # With nothing specified, offer a slicer import before asking for a password.
    if interactive and not args.account:
        peek = mw.find_slicer_token()
        if peek and not peek.get("error"):
            where = peek["source"].split(":")[0]
            ans = input(f"Found a Bambu Cloud token in {where}. "
                        f"Use it (no password needed)? [Y/n]: ").strip().lower()
            if ans in ("", "y", "yes"):
                return _import_from_slicer(None)

    if not interactive and not (args.account and args.password_stdin):
        print("makerworld-login needs a terminal (password + emailed code prompts).\n"
              "Open a normal terminal and run:  makerworld-login\n"
              "Or:  makerworld-login --from-slicer   (import from Bambu Studio / Orca)\n"
              "Or:  makerworld-login --account you@example.com --password-stdin < pwfile",
              file=sys.stderr)
        return 2

    region = args.region
    if not region:
        ans = input("Region [global/china] (default global): ").strip().lower() if interactive else ""
        region = "china" if ans in ("china", "cn") else "global"
    region = mw.norm_region(region)
    base = mw.api_base(region)

    account = args.account or (input("Bambu account (email or phone): ").strip() if interactive else "")
    if not account:
        print("no account given", file=sys.stderr)
        return 2

    if args.password_stdin:
        password = sys.stdin.readline().rstrip("\n")
    else:
        password = getpass.getpass("Password: ")
    if not password:
        print("no password given", file=sys.stderr)
        return 2

    print(f"\nSigning in to {base} ...")
    res = mw.http("POST", base + "/v1/user-service/user/login",
                  payload={"account": account, "password": password, "apiError": ""})
    obj = res.json() or {}

    tokens = _extract_tokens(obj)

    if not tokens and _tfa_key(obj):
        key = _tfa_key(obj)
        print("This account has two-factor authentication enabled.")
        code = (args.code or "").strip()
        if not code and interactive:
            code = input("Authenticator (TFA) code: ").strip()
        if not code:
            print("re-run with --code <authenticator code>", file=sys.stderr)
            return 2
        tres = mw.http("POST", mw.tfa_base(region) + "/api/sign-in/tfa",
                       payload={"tfaKey": key, "tfaCode": code})
        tobj = tres.json() or {}
        tokens = _extract_tokens(tobj)
        if not tokens:
            # Some deployments return the token only as a Set-Cookie: token=...
            cookie = str(tres.headers.get("Set-Cookie", ""))
            for part in cookie.split(";"):
                part = part.strip()
                if part.lower().startswith("token="):
                    tokens = {"accessToken": part[6:], "refreshToken": "", "expiresIn": None}
                    break
        if not tokens:
            print("TFA verification did not return a token. Raw response:")
            print(json.dumps(tobj, indent=2)[:2000])
            return 1

    if not tokens and _needs_code(obj):
        print("A verification code has been emailed to you by Bambu Lab.")
        # Best-effort re-trigger; harmless if the endpoint name is wrong.
        try:
            mw.http("POST", base + "/v1/user-service/user/sendemail/code",
                    payload={"email": account, "type": "codeLogin"})
        except SystemExit:
            pass
        code = (args.code or "").strip()
        if not code and interactive:
            code = input("Email verification code: ").strip()
        if not code:
            print("check your email, then re-run with --code <code>", file=sys.stderr)
            return 2
        vres = mw.http("POST", base + "/v1/user-service/user/login",
                       payload={"account": account, "code": code})
        vobj = vres.json() or {}
        tokens = _extract_tokens(vobj)
        if not tokens:
            print("Code verification did not return a token. Raw response:")
            print(json.dumps(vobj, indent=2)[:2000])
            return 1

    if not tokens:
        print("Unexpected login response - no token and no known challenge:")
        print(json.dumps(obj, indent=2)[:2000])
        print("\nYou can still use:  makerworld-token --paste  (token from browser dev tools)")
        return 1

    record = {
        "accessToken": tokens["accessToken"],
        "refreshToken": tokens.get("refreshToken", ""),
        "region": region,
        "account": account,
    }
    return _finish(record, "Bambu account login")


if __name__ == "__main__":
    raise SystemExit(main())
